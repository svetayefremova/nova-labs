{
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-simulator": {
      "channel": "development-simulator",
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production"
    }
  },
  "cli": {
    "appVersionSource": "remote",
    "version": ">=18.7.0"
  }
}
